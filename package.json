{
  "name": "ai-agent-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Customer-support AI agent with tool calling, guardrails and human approval (NestJS + Next.js)",
  "license": "MIT",
  "author": "Kevin Makwana",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "seed": "npm run seed -w apps/api",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w apps/api && npm test -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/api",
    "screenshot": "node scripts/screenshot.mjs",
    "lint": "eslint apps scripts eslint.config.mjs --max-warnings 44",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"*.mjs\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
