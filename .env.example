# Copy to .env (cp .env.example .env). Every value below is optional:
# the defaults run the whole stack offline with the mock provider.

# --- Postgres (docker compose) -------------------------------------------
# Host port for the container. Change it if 5432 is already taken.
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aiagent
# Optional full connection string; overrides the DB_* values above.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiagent

# --- API / web -------------------------------------------------------------
API_PORT=3001
# Where the Next.js server proxies /api/* to.
API_URL=http://localhost:3001
# Optional shared secret for reviewer routes (/approvals, /customers, listing conversations); also makes
# conversations require their access token. Unset = open demo mode. Enter it at /reviewer in the web app.
REVIEWER_API_KEY=
# Hard cap on model calls per run (agent loop step limit).
AGENT_MAX_STEPS=8
# Max tokens (input + output) one conversation may use before the agent stops calling the model.
CONVERSATION_TOKEN_BUDGET=200000
# Rough cap (tokens) on the history sent to the model per call; older turns are left out of what it sees.
CONTEXT_MAX_TOKENS=8000
# Pending approvals older than this many minutes are auto-rejected (the customer is told). 0 = never expire.
APPROVAL_TTL_MINUTES=1440
# Refunds are approved automatically (and logged as such) when this refund plus earlier refunds on the
# same order stays under this many dollars. 0 or unset = every refund waits for a reviewer.
REFUND_AUTO_APPROVE_UNDER=0
# Four-eyes (needs reviewer accounts): refunds of MORE than this many dollars need two different reviewers
# (0 or unset = off); set FOUR_EYES_CANCELLATIONS=true to require two for every cancellation.
# FOUR_EYES_REFUND_OVER=0
# FOUR_EYES_CANCELLATIONS=false
# Reviewer accounts: once the first reviewer exists (npm run reviewer:add -w apps/api), REVIEWER_API_KEY is ignored.
# Session lifetime in hours (absolute; sessions also end after 30 idle minutes).
# SESSION_TTL_HOURS=12
# Adds Secure to the session cookie. Defaults to true when NODE_ENV=production; set false for plain-HTTP deployments.
# COOKIE_SECURE=false
# POST /auth/login per client per minute.
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# Customer login (off by default). When on, customers sign in with a one-time emailed link and a conversation can only
# be used by the customer it belongs to. Needs a mail server below. Does not apply to reviewers.
# CUSTOMER_LOGIN=false
# LOGIN_SMTP_URL=smtp://user:pass@smtp.example.com:587
# LOGIN_EMAIL_FROM=support@example.com
# Where the emailed link points (the customer web app), and how long a customer session lasts.
# CUSTOMER_APP_URL=http://localhost:3000
# CUSTOMER_SESSION_TTL_DAYS=7
# POST /customer-auth/request and /verify per client per minute.
# RATE_LIMIT_CUSTOMER_LOGIN_PER_MINUTE=5
# Caps on concurrent live-update (SSE) streams; over the cap the API answers 429.
STREAM_MAX_PER_CONVERSATION=5
STREAM_MAX_REVIEWER=20

# --- HTTP hardening --------------------------------------------------------
# Rate limits per client per minute. The two strict ones guard routes that start work or cost LLM calls.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_START_PER_MINUTE=10
RATE_LIMIT_MESSAGES_PER_MINUTE=20
# Browser origins allowed to call the API directly (comma-separated, exact origins). Empty = none;
# the bundled web app does not need this because it proxies through Next.js.
CORS_ORIGINS=
# Number of reverse-proxy hops whose X-Forwarded-For to trust for client identity (0 = none). Set it
# to 1 when the API sits behind the Next.js proxy AND a load balancer that sets X-Forwarded-For;
# leave it at 0 otherwise, or clients can spoof their address and dodge the limits.
TRUST_PROXY=0

# --- Reviewer notifications ------------------------------------------------
# Announce new pending approvals to reviewers. Every channel is optional; none set = notifications off.
# Webhook URLs must be https (plain http only for localhost). Values are never echoed in error messages.
# Generic JSON webhook; with a secret, each request carries an HMAC-SHA256 signature of the body.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
# Slack incoming-webhook URL.
NOTIFY_SLACK_WEBHOOK_URL=
# Email: all three together. NOTIFY_EMAIL_TO is a comma-separated list of plain addresses.
# e.g. NOTIFY_SMTP_URL=smtps://user:pass@smtp.example.com:465 (percent-encode @ # : in the password; no ?query allowed;
# a remote smtp:// host requires STARTTLS)
NOTIFY_SMTP_URL=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
# Link put in every message. Default: http://localhost:3000/reviewer
REVIEWER_CONSOLE_URL=

# --- LLM provider ----------------------------------------------------------
# mock (default, offline, deterministic) | openai | anthropic
LLM_PROVIDER=mock
# Artificial per-call delay for the mock so the live trace is easy to watch.
MOCK_DELAY_MS=150

# Extra attempts for retryable provider failures (network errors, 408, 429, 5xx), with exponential backoff
# and jitter, honouring Retry-After. 0 disables retries.
LLM_MAX_RETRIES=2
# Output cap per model call (reasoning/thinking tokens count against it). Unset = Anthropic 4096, OpenAI the model's own limit.
# LLM_MAX_TOKENS=4096

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible endpoint if you like.
OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
